{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des Points de Collecte{% endblock %}
{% block page_title %}Points de Collecte{% endblock %}

{% block body %}
<a href="#" class="btn btn-success mb-3">Ajouter un point de collecte</a>

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Adresse</th>
                <th>Types acceptés</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Centre ville</td>
                <td>Avenue Habib Bourguiba</td>
                <td>Verre, Plastique, Papier</td>
                <td><span class="badge bg-success">Actif</span></td>
                <td>
                    <a href="#" class="btn btn-sm btn-info">Voir</a>
                    <a href="#" class="btn btn-sm btn-warning">Modifier</a>
                    <a href="#" class="btn btn-sm btn-danger">Supprimer</a>
                </td>
            </tr>
        </tbody>
    </table>
</div>
{% endblock %}
